<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/fondo_principal"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        LinearLayout principal:
        - Organiza los elementos en columna (vertical).
        - Centra todo su contenido.
        - Aplica un color de fondo definido en los recursos .
        - padding: agrega espacio interno de 20dp alrededor.
        - match_parent: ocupa todo el ancho y alto de la pantalla.
    -->

    <!-- Título con el nombre del personaje -->
    <TextView
        android:text="@string/personaje_2"
        android:textColor="@color/texto_principal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Imagen del personaje -->
    <ImageView
        android:id="@+id/imagenPersonaje2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/personaje_2"
        android:background="@color/purple_700"
        android:layout_gravity="center"
        android:src="@drawable/personaje2" />

    <!-- Texto que indica que el usuario debe poner el nombre -->
    <TextView
        android:text="@string/nombre_del_personaje"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor= "#00796B"/>

    <!-- Campo de texto donde el usuario escribe el nombre del personaje -->
    <EditText
        android:id="@+id/nombre2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/boton_fondo"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/campo_texto_hint"
        android:autofillHints="name"
        android:hint="@string/escribe_un_nombre"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        tools:ignore="VisualLintTextFieldSize" />

    <!-- Contenedor para los botones "Atras", "Borrar" y "Siguiente" -->
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Botón para volver a la pastaña del personaje anterior. -->
        <Button
            android:id="@+id/btnAtras2"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/atras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00796B" />

        <!-- Botón para borrar el nombre escrito -->
        <Button
            android:id="@+id/btnBorrar2"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/borrar"
            android:textColor="#007968" />

        <!-- Botón para pasar al siguiente personaje -->
        <Button
            android:id="@+id/btnSiguiente2"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/siguiente"
            android:textColor="#00796B" />
    </LinearLayout>

</LinearLayout>
